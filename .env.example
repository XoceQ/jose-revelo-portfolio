# Frontend variables are PUBLIC: they are compiled into the site.
# Never put a token, password or secret in a VITE_ variable.

# "/" for a user site or custom domain, "/repo-name/" for a project site.
VITE_BASE_PATH=/
# Canonical public URL, without a trailing slash.
VITE_SITE_URL=https://xoceq.github.io
# Public URL of the payment backend. Empty = all services show "Request a Quote".
VITE_PAYMENT_API_URL=
# JSON form endpoint, such as https://formspree.io/f/your-form-id.
# Empty = the form opens the visitor's email app instead.
VITE_CONTACT_ENDPOINT=
