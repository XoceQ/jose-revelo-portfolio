# Copy to backend/.env for local work. Never commit the real file.

# Mercado Pago > Your integrations > your application > credentials.
# Use test credentials until you are ready to accept real payments.
MP_ACCESS_TOKEN=
# Mercado Pago > Your integrations > Webhooks > Configure notifications > secret signature.
MP_WEBHOOK_SECRET=
# true = send buyers to sandbox_init_point. Must be false in production.
MP_USE_SANDBOX=true

# Signs private payment links. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYMENT_LINK_SECRET=

# Public site URL, including the GitHub Pages path if there is one.
FRONTEND_URL=https://xoceq.github.io/portfolio
# Public HTTPS URL of this backend. Required for webhooks.
PUBLIC_API_URL=https://your-backend.example.com
# Comma-separated browser origins. An origin has no path.
ALLOWED_ORIGINS=https://xoceq.github.io,http://localhost:5173

# Must be on persistent storage in production.
DATABASE_PATH=data/payments.db
